# Copy to config.local.properties and edit when using YOUR app.
# config.local.properties is gitignored.

# Platform: ios | android  (or pass -Dplatform=android)
platform=ios

# Appium server
appium.server.url=http://127.0.0.1:4723

# --- iOS (sample ShopMate app) ---
ios.platform.version=26.5
ios.device.name=iPhone 17
ios.app.path=apps/shopmate-ios/dist/ShopMate.app
ios.bundle.id=com.mobtest.shopmate

# --- Android (sample ShopMate app) ---
android.platform.version=16
android.device.name=emulator-5554
android.app.path=apps/shopmate-android/dist/shopmate-debug.apk
android.app.package=com.mobtest.shopmate
android.app.activity=com.mobtest.shopmate.MainActivity

# --- Local LLM (Ollama — free, no API key) ---
ollama.endpoint=http://localhost:11434/api/chat
ollama.model=llama3.1

# Set true to skip LLM and use built-in heuristic planner (fast smoke tests)
agent.heuristic.only=false

# Cloud (optional BrowserStack trial)
run.cloud=false

# --- Teardown (local runs) ---
# Quit Appium session and terminate the app after each @Test method
driver.cleanup.after.test=true
# Shut down simulators/emulators when the suite finishes (frees RAM)
device.shutdown.after.suite=true
# Boot iOS simulator from Java before each test (run-tests.sh boots for you)
device.auto.boot=false
# Set automatically by ./scripts/run-tests.sh when it boots a device
device.managed.by.framework=false
